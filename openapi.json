      "post": {
        "summary": "Order request contract — purchasing disabled",
        "description": "Контракт заказа: покупки пока отключены. Valid requests return 503 PURCHASING_NOT_ENABLED; no charge or order is created. Idempotency storage, supplier fulfillment and accounting must be implemented before this gate opens.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "product_id",
                  "external_id",
                  "quantity",
                  "fields"
                ],
                "properties": {
                  "product_id": {
                    "type": "string",
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "external_id": {
                    "type": "string",
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "quantity": {
                    "type": "integer",
                    "enum": [
                      1
                    ]
                  },
                  "fields": {
                    "type": "object"
                  }
                }
              },
              "example": {
                "product_id": "PRODUCT_ID",
                "external_id": "YOUR_ORDER_ID",
                "quantity": 1,
                "fields": {}
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Error / Ошибка",
            "content": {
